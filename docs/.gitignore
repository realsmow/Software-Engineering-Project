# Claude Code local settings - machine-local, not shared.
.claude/settings.local.json

# บันทึกความคืบหน้าของ SA - เป็นสมุดงานส่วนตัว มีโน้ตระหว่างทางที่ยังไม่สรุป
# สิ่งที่ทีมต้องอ่านอยู่ในรายงานที่ report/ แล้ว
PROGRESS.md

# LaTeX build output - the whole folder is generated by latexmk (.latexmkrc sets
# $out_dir = 'build'). Everything in here can be rebuilt from the .tex sources,
# so it must not be committed.
#
# PDF ที่ตั้งใจแจกให้คนอื่นอ่าน อยู่ที่ report/ ที่เดียว - คัดลอกด้วย
#     cp build/<name>.pdf report/
# ถ้าปล่อยให้ build/ อยู่ใน git ด้วย จะมี PDF สองชุดที่ไม่ตรงกัน แล้วมีคนหยิบผิดตัว
build/

# LaTeX intermediate files, in case anything is built outside build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot
*.xdv

# ============================================================================
#  ต่อจากนี้เพิ่มเมื่อ 4 ก.ย. 2569 ตอนเตรียม commit เอกสารครั้งแรก
#
#  เหตุผล: `git add docs/` ก่อนหน้านี้จะลากไฟล์เข้าไป 201 ไฟล์ 54 MB ซึ่งเกือบ
#  ทั้งหมดเป็นของที่สร้างใหม่ได้ หรือไม่ใช่ผลงานของทีม การ commit ของพวกนี้
#  ทำให้ทุกคนต้องโหลดตามทุกครั้งที่ clone โดยไม่ได้อะไรเพิ่ม
#  หลังเพิ่มบล็อกนี้แล้วเหลือราว 8 MB
# ============================================================================

# วัตถุดิบจากวิชาและจากทีม - ไม่ใช่ผลงานของเรา (27 MB)
# สไลด์ประกอบวิชา Week 05/06, ไฟล์ Excel ของทีม, PDF สคีมา ฯลฯ
# ทุกคนมีจากช่องทางเดิมอยู่แล้ว ไม่ต้องแจกซ้ำผ่าน git
resource/

# รูปสไลด์ที่สคริปต์สร้าง - แก้ข้อมูลใน *_data.py แล้วรันใหม่ได้เสมอ
# PNG หนักกว่า SVG หลายเท่าโดยเห็นเท่ากัน จึงเก็บเฉพาะ SVG ที่เล็ก
slides/**/*.png
# SVG ของ ui-slides ฝังภาพหน้าจอไว้ข้างใน เลยหนัก 5.2 MB
slides/ui-slides/
# ภาพหน้าจอดิบที่ตัดมาจากบอร์ด สร้างใหม่ได้ด้วย extract_screens.py
slides/screens/

# ผัง BPMN - เก็บ .bpmn (ต้นฉบับ), svg และ pdf ไว้ ตัด png ออก (2.3 MB)
bpmn/png/

# Python cache
__pycache__/
*.pyc

# เศษไฟล์
sc-06.png
