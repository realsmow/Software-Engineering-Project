<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_renew" targetNamespace="http://ulms.cpe/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_renew" name="กระบวนการยืมต่อ">
    <bpmn:participant id="Participant_user" name="ผู้ยืม (User)" processRef="Process_user" />
    <bpmn:participant id="Participant_system" name="ระบบ ULMs (System)" processRef="Process_system" />
    <bpmn:participant id="Participant_staff" name="เจ้าหน้าที่ (Staff)" processRef="Process_staff" />
    <bpmn:participant id="Participant_supervisor" name="อาจารย์ผู้ดูแล (Supervisor)" processRef="Process_supervisor" />
    <bpmn:messageFlow id="MsgFlow_2" name="ใบตรวจสภาพอุปกรณ์" sourceRef="system_ask_staff" targetRef="staff_recv" />
    <bpmn:messageFlow id="MsgFlow_3" name="ผลตรวจสภาพอุปกรณ์" sourceRef="staff_send" targetRef="system_wait_insp" />
    <bpmn:messageFlow id="MsgFlow_4" name="คำขอยืมต่อรออนุมัติ" sourceRef="system_ask_sup" targetRef="supervisor_recv" />
    <bpmn:messageFlow id="MsgFlow_5" name="ผลพิจารณา: อนุมัติ" sourceRef="supervisor_send_ok" targetRef="system_wait_dec" />
    <bpmn:messageFlow id="MsgFlow_6" name="ผลพิจารณา: ไม่อนุมัติ" sourceRef="supervisor_send_no" targetRef="system_wait_dec" />
    <bpmn:messageFlow id="MsgFlow_7" name="แจ้งผล: T3 ต่ออายุไม่ได้" sourceRef="system_notify_t3" targetRef="user_wait" />
    <bpmn:messageFlow id="MsgFlow_8" name="แจ้งผล: ไม่อนุมัติ" sourceRef="system_notify_rej" targetRef="user_wait" />
    <bpmn:messageFlow id="MsgFlow_9" name="แจ้งผล: ยืมต่อสำเร็จ" sourceRef="system_notify_user" targetRef="user_wait" />
    <bpmn:messageFlow id="MsgFlow_1" name="คำขอยืมต่อ" sourceRef="user_select" targetRef="system_recv" />
  </bpmn:collaboration>
  <bpmn:process id="Process_user" isExecutable="false">
    <bpmn:startEvent id="user_start" name="เริ่ม">
      <bpmn:outgoing>Flow_user_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="user_select" name="เลือกรายการอุปกรณ์ ที่ต้องการยืมต่อ">
      <bpmn:incoming>Flow_user_1</bpmn:incoming>
      <bpmn:outgoing>Flow_1rqklc1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_user_1" name="" sourceRef="user_start" targetRef="user_select" />
    <bpmn:sequenceFlow id="Flow_1rqklc1" sourceRef="user_select" targetRef="user_gw_res" />
    <bpmn:userTask id="user_resubmit" name="ส่งคำขอยืมใหม่ อีกครั้ง">
      <bpmn:incoming>Flow_user_5</bpmn:incoming>
      <bpmn:outgoing>Flow_user_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="user_end_new" name="เริ่มคำขอใหม่">
      <bpmn:incoming>Flow_user_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_user_5" name="ใช่ (T3)" sourceRef="user_gw_res" targetRef="user_resubmit" />
    <bpmn:sequenceFlow id="Flow_user_6" name="" sourceRef="user_resubmit" targetRef="user_end_new" />
    <bpmn:sequenceFlow id="Flow_1ofkoa4" name="ไม่" sourceRef="user_gw_res" targetRef="user_wait" />
    <bpmn:exclusiveGateway id="user_gw_res" name="ต้องส่งคำขอใหม่?">
      <bpmn:incoming>Flow_1rqklc1</bpmn:incoming>
      <bpmn:outgoing>Flow_user_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ofkoa4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1g4xxh7" sourceRef="user_wait" targetRef="user_end_done" />
    <bpmn:endEvent id="user_end_done" name="จบการยืมต่อ">
      <bpmn:incoming>Flow_1g4xxh7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="user_wait" name="รับแจ้งผลการยืมต่อ">
      <bpmn:incoming>Flow_1ofkoa4</bpmn:incoming>
      <bpmn:outgoing>Flow_1g4xxh7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_user_wait" />
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
  <bpmn:process id="Process_system" isExecutable="false">
    <bpmn:startEvent id="system_recv" name="รับคำขอยืมต่อ">
      <bpmn:outgoing>Flow_system_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_recv" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="system_gw_t12" name="เป็น T1 หรือ T2?">
      <bpmn:incoming>Flow_system_1</bpmn:incoming>
      <bpmn:outgoing>Flow_system_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="system_gw_t1" name="เป็น T1?">
      <bpmn:incoming>Flow_system_2</bpmn:incoming>
      <bpmn:outgoing>Flow_system_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="system_gw_first" name="ต่ออายุครั้งที่ 1?">
      <bpmn:incoming>Flow_system_4</bpmn:incoming>
      <bpmn:outgoing>Flow_system_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="system_ask_staff" name="แจ้งเจ้าหน้าที่ ตรวจสภาพอุปกรณ์">
      <bpmn:incoming>Flow_system_6</bpmn:incoming>
      <bpmn:outgoing>Flow_system_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="system_gw_dmg" name="พบความเสียหาย?">
      <bpmn:incoming>Flow_system_9</bpmn:incoming>
      <bpmn:outgoing>Flow_system_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="system_wait_dec" name="รอผลพิจารณา">
      <bpmn:incoming>Flow_system_13</bpmn:incoming>
      <bpmn:outgoing>Flow_system_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_wait_dec" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="system_discredit" name="คำนวณการหักเครดิต (Discredit)">
      <bpmn:incoming>Flow_system_10</bpmn:incoming>
      <bpmn:outgoing>Flow_system_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="system_gw_t0" name="เป็น T0?">
      <bpmn:incoming>Flow_system_3</bpmn:incoming>
      <bpmn:outgoing>Flow_system_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="system_end_t3" name="ปิดคำขอ (T3)">
      <bpmn:incoming>Flow_system_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="system_merge_ok" name="">
      <bpmn:incoming>Flow_system_7</bpmn:incoming>
      <bpmn:incoming>Flow_system_11</bpmn:incoming>
      <bpmn:incoming>Flow_system_12</bpmn:incoming>
      <bpmn:incoming>Flow_system_15</bpmn:incoming>
      <bpmn:incoming>Flow_system_18</bpmn:incoming>
      <bpmn:outgoing>Flow_system_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="system_fork" name="">
      <bpmn:incoming>Flow_system_21</bpmn:incoming>
      <bpmn:outgoing>Flow_system_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_23</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="system_notify_user" name="แจ้งเตือนผู้ยืม">
      <bpmn:incoming>Flow_system_22</bpmn:incoming>
      <bpmn:outgoing>Flow_system_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="system_update" name="อัปเดตข้อมูล อุปกรณ์และผู้ยืม">
      <bpmn:incoming>Flow_system_23</bpmn:incoming>
      <bpmn:outgoing>Flow_system_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="system_join" name="">
      <bpmn:incoming>Flow_system_24</bpmn:incoming>
      <bpmn:incoming>Flow_system_25</bpmn:incoming>
      <bpmn:outgoing>Flow_system_26</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="system_end_ok" name="ปิดรายการยืมต่อ">
      <bpmn:incoming>Flow_system_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="system_notify_rej" name="แจ้งผู้ยืม: ไม่อนุมัติ">
      <bpmn:incoming>Flow_system_16</bpmn:incoming>
      <bpmn:outgoing>Flow_system_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="system_end_rej" name="ปิดคำขอ (ไม่อนุมัติ)">
      <bpmn:incoming>Flow_system_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_system_1" name="" sourceRef="system_recv" targetRef="system_gw_t12" />
    <bpmn:sequenceFlow id="Flow_system_2" name="ใช่ (T1/T2)" sourceRef="system_gw_t12" targetRef="system_gw_t1" />
    <bpmn:sequenceFlow id="Flow_system_3" name="ไม่ (T0/T3)" sourceRef="system_gw_t12" targetRef="system_gw_t0" />
    <bpmn:sequenceFlow id="Flow_system_4" name="ใช่ (T1)" sourceRef="system_gw_t1" targetRef="system_gw_first" />
    <bpmn:sequenceFlow id="Flow_system_5" name="ไม่ (T2)" sourceRef="system_gw_t1" targetRef="system_ask_sup" />
    <bpmn:sequenceFlow id="Flow_system_6" name="ไม่" sourceRef="system_gw_first" targetRef="system_ask_staff" />
    <bpmn:sequenceFlow id="Flow_system_7" name="ใช่" sourceRef="system_gw_first" targetRef="system_merge_ok" />
    <bpmn:sequenceFlow id="Flow_system_8" name="" sourceRef="system_ask_staff" targetRef="system_wait_insp" />
    <bpmn:sequenceFlow id="Flow_system_9" name="" sourceRef="system_wait_insp" targetRef="system_gw_dmg" />
    <bpmn:sequenceFlow id="Flow_system_10" name="พบ" sourceRef="system_gw_dmg" targetRef="system_discredit" />
    <bpmn:sequenceFlow id="Flow_system_11" name="ไม่พบ" sourceRef="system_gw_dmg" targetRef="system_merge_ok" />
    <bpmn:sequenceFlow id="Flow_system_12" name="" sourceRef="system_discredit" targetRef="system_merge_ok" />
    <bpmn:sequenceFlow id="Flow_system_13" name="" sourceRef="system_ask_sup" targetRef="system_wait_dec" />
    <bpmn:sequenceFlow id="Flow_system_14" name="" sourceRef="system_wait_dec" targetRef="system_gw_dec" />
    <bpmn:sequenceFlow id="Flow_system_15" name="อนุมัติ" sourceRef="system_gw_dec" targetRef="system_merge_ok" />
    <bpmn:sequenceFlow id="Flow_system_16" name="ไม่อนุมัติ" sourceRef="system_gw_dec" targetRef="system_notify_rej" />
    <bpmn:sequenceFlow id="Flow_system_17" name="" sourceRef="system_notify_rej" targetRef="system_end_rej" />
    <bpmn:sequenceFlow id="Flow_system_18" name="ใช่ (T0)" sourceRef="system_gw_t0" targetRef="system_merge_ok" />
    <bpmn:sequenceFlow id="Flow_system_19" name="ไม่ (T3)" sourceRef="system_gw_t0" targetRef="system_notify_t3" />
    <bpmn:sequenceFlow id="Flow_system_20" name="" sourceRef="system_notify_t3" targetRef="system_end_t3" />
    <bpmn:sequenceFlow id="Flow_system_21" name="" sourceRef="system_merge_ok" targetRef="system_fork" />
    <bpmn:sequenceFlow id="Flow_system_22" name="" sourceRef="system_fork" targetRef="system_notify_user" />
    <bpmn:sequenceFlow id="Flow_system_23" name="" sourceRef="system_fork" targetRef="system_update" />
    <bpmn:sequenceFlow id="Flow_system_24" name="" sourceRef="system_notify_user" targetRef="system_join" />
    <bpmn:sequenceFlow id="Flow_system_25" name="" sourceRef="system_update" targetRef="system_join" />
    <bpmn:sequenceFlow id="Flow_system_26" name="" sourceRef="system_join" targetRef="system_end_ok" />
    <bpmn:exclusiveGateway id="system_gw_dec" name="ผลพิจารณา?">
      <bpmn:incoming>Flow_system_14</bpmn:incoming>
      <bpmn:outgoing>Flow_system_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="system_notify_t3" name="แจ้งผู้ยืม: T3 ต่ออายุไม่ได้">
      <bpmn:incoming>Flow_system_19</bpmn:incoming>
      <bpmn:outgoing>Flow_system_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="system_wait_insp" name="รอผลตรวจสภาพ">
      <bpmn:incoming>Flow_system_8</bpmn:incoming>
      <bpmn:outgoing>Flow_system_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_wait_insp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="system_ask_sup" name="ส่งคำขอ ให้อาจารย์พิจารณา">
      <bpmn:incoming>Flow_system_5</bpmn:incoming>
      <bpmn:outgoing>Flow_system_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:association id="Assoc_system_rule_tier" sourceRef="system_gw_t12" targetRef="system_rule_tier" />
    <bpmn:textAnnotation id="system_rule_tier">
      <bpmn:text>เงื่อนไขตามระดับอุปกรณ์ 
T0: ต่ออายุได้ทันที 
T1: ครั้งที่ 1 ได้ทันที ครั้งถัดไปต้องตรวจสภาพ T2: ต้องให้อาจารย์อนุมัติ
T3: ต่ออายุไม่ได้ ต้องส่งคำขอใหม่</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Process_staff" isExecutable="false">
    <bpmn:exclusiveGateway id="staff_gw_dmg" name="พบความเสียหาย?">
      <bpmn:incoming>Flow_staff_2</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_staff_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="staff_assess" name="ประเมินระดับความเสียหาย (B0–B3) &#38; บันทึกผล">
      <bpmn:incoming>Flow_staff_3</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="staff_merge" name="">
      <bpmn:incoming>Flow_staff_4</bpmn:incoming>
      <bpmn:incoming>Flow_staff_5</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_staff_1" name="" sourceRef="staff_recv" targetRef="staff_inspect" />
    <bpmn:sequenceFlow id="Flow_staff_2" name="" sourceRef="staff_inspect" targetRef="staff_gw_dmg" />
    <bpmn:sequenceFlow id="Flow_staff_3" name="พบ" sourceRef="staff_gw_dmg" targetRef="staff_assess" />
    <bpmn:sequenceFlow id="Flow_staff_4" name="ไม่พบ" sourceRef="staff_gw_dmg" targetRef="staff_merge" />
    <bpmn:sequenceFlow id="Flow_staff_5" name="" sourceRef="staff_assess" targetRef="staff_merge" />
    <bpmn:sequenceFlow id="Flow_staff_6" name="" sourceRef="staff_merge" targetRef="staff_send" />
    <bpmn:sequenceFlow id="Flow_staff_7" name="" sourceRef="staff_send" targetRef="staff_end" />
    <bpmn:sendTask id="staff_send" name="ส่งผลตรวจสภาพ ให้ระบบ">
      <bpmn:incoming>Flow_staff_6</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="staff_end" name="จบงานตรวจสภาพ">
      <bpmn:incoming>Flow_staff_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="staff_inspect" name="ตรวจสภาพอุปกรณ์">
      <bpmn:incoming>Flow_staff_1</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:startEvent id="staff_recv" name="รับแจ้งให้ตรวจสภาพ">
      <bpmn:outgoing>Flow_staff_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_staff_recv" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="Process_supervisor" isExecutable="false">
    <bpmn:userTask id="supervisor_review" name="ตรวจสอบรายละเอียดคำขอ &#38; เหตุผลการใช้งาน">
      <bpmn:incoming>Flow_supervisor_1</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="supervisor_gw_dec" name="ผลพิจารณา?">
      <bpmn:incoming>Flow_supervisor_2</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_supervisor_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="supervisor_send_ok" name="แจ้งผลอนุมัติ">
      <bpmn:incoming>Flow_supervisor_3</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="supervisor_end_ok" name="จบการพิจารณา">
      <bpmn:incoming>Flow_supervisor_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="supervisor_send_no" name="แจ้งผลไม่อนุมัติ">
      <bpmn:incoming>Flow_supervisor_4</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="supervisor_end_no" name="จบการพิจารณา">
      <bpmn:incoming>Flow_supervisor_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_supervisor_1" name="" sourceRef="supervisor_recv" targetRef="supervisor_review" />
    <bpmn:sequenceFlow id="Flow_supervisor_2" name="" sourceRef="supervisor_review" targetRef="supervisor_gw_dec" />
    <bpmn:sequenceFlow id="Flow_supervisor_3" name="อนุมัติ" sourceRef="supervisor_gw_dec" targetRef="supervisor_send_ok" />
    <bpmn:sequenceFlow id="Flow_supervisor_4" name="ไม่อนุมัติ" sourceRef="supervisor_gw_dec" targetRef="supervisor_send_no" />
    <bpmn:sequenceFlow id="Flow_supervisor_5" name="" sourceRef="supervisor_send_ok" targetRef="supervisor_end_ok" />
    <bpmn:sequenceFlow id="Flow_supervisor_6" name="" sourceRef="supervisor_send_no" targetRef="supervisor_end_no" />
    <bpmn:startEvent id="supervisor_recv" name="รับคำขออนุมัติ">
      <bpmn:outgoing>Flow_supervisor_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_supervisor_recv" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_renew">
    <bpmndi:BPMNPlane id="BPMNPlane_renew" bpmnElement="Collaboration_renew">
      <bpmndi:BPMNShape id="Participant_user_di" bpmnElement="Participant_user" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="3250" height="294" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_start_di" bpmnElement="user_start">
        <dc:Bounds x="224" y="146" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="234" y="185" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_select_di" bpmnElement="user_select">
        <dc:Bounds x="342" y="120" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_resubmit_di" bpmnElement="user_resubmit">
