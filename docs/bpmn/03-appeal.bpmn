        <bpmndi:BPMNLabel>
          <dc:Bounds x="906" y="719" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="system_end_keep_di" bpmnElement="system_end_keep">
        <dc:Bounds x="2462" y="680" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2508" y="686" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_system_1_di" bpmnElement="Flow_system_1">
        <di:waypoint x="260" y="574" />
        <di:waypoint x="322" y="574" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_system_2_di" bpmnElement="Flow_system_2">
        <di:waypoint x="492" y="574" />
        <di:waypoint x="548" y="574" />
