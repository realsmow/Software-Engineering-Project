<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_appeal" targetNamespace="http://ulms.cpe/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_appeal" name="กระบวนการอุทธรณ์">
    <bpmn:participant id="Participant_user" name="ผู้ยืม (User)" processRef="Process_user" />
    <bpmn:participant id="Participant_system" name="ระบบ ULMs (System)" processRef="Process_system" />
    <bpmn:participant id="Participant_supervisor" name="อาจารย์ผู้ดูแล (Supervisor)" processRef="Process_supervisor" />
    <bpmn:messageFlow id="MsgFlow_1" name="ผลการประเมินและการหักคะแนน" sourceRef="system_send_result" targetRef="user_recv" />
    <bpmn:messageFlow id="MsgFlow_2" name="คำอุทธรณ์" sourceRef="user_submit" targetRef="system_catch_appeal" />
    <bpmn:messageFlow id="MsgFlow_3" name="แจ้งคำอุทธรณ์รอพิจารณา" sourceRef="system_notify_sup" targetRef="supervisor_recv" />
    <bpmn:messageFlow id="MsgFlow_4" name="ผลพิจารณา: เห็นชอบ" sourceRef="supervisor_send_agree" targetRef="system_wait_dec" />
    <bpmn:messageFlow id="MsgFlow_5" name="ผลพิจารณา: ไม่เห็นชอบ" sourceRef="supervisor_send_disagree" targetRef="system_wait_dec" />
    <bpmn:messageFlow id="MsgFlow_6" name="แจ้งผล: ยืนผลเดิม" sourceRef="system_notify_keep" targetRef="user_wait" />
    <bpmn:messageFlow id="MsgFlow_7" name="แจ้งผล: แก้ไขเครดิตแล้ว" sourceRef="system_notify_user" targetRef="user_wait" />
  </bpmn:collaboration>
  <bpmn:process id="Process_user" isExecutable="false">
    <bpmn:startEvent id="user_recv" name="รับผลการประเมิน">
      <bpmn:outgoing>Flow_user_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_user_recv" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="user_gw_appeal" name="ยื่นอุทธรณ์?">
      <bpmn:incoming>Flow_user_1</bpmn:incoming>
      <bpmn:outgoing>Flow_user_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_user_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="user_submit" name="ส่งคำอุทธรณ์ และระบุเหตุผล">
      <bpmn:incoming>Flow_user_2</bpmn:incoming>
      <bpmn:outgoing>Flow_user_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="user_end_accept" name="ยอมรับผลประเมิน">
      <bpmn:incoming>Flow_user_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="user_wait" name="รับผลพิจารณาอุทธรณ์">
      <bpmn:incoming>Flow_user_4</bpmn:incoming>
      <bpmn:outgoing>Flow_user_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_user_wait" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="user_end" name="จบกระบวนการอุทธรณ์">
      <bpmn:incoming>Flow_user_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_user_1" name="" sourceRef="user_recv" targetRef="user_gw_appeal" />
    <bpmn:sequenceFlow id="Flow_user_2" name="ใช่" sourceRef="user_gw_appeal" targetRef="user_submit" />
    <bpmn:sequenceFlow id="Flow_user_3" name="ไม่" sourceRef="user_gw_appeal" targetRef="user_end_accept" />
    <bpmn:sequenceFlow id="Flow_user_4" name="" sourceRef="user_submit" targetRef="user_wait" />
    <bpmn:sequenceFlow id="Flow_user_5" name="" sourceRef="user_wait" targetRef="user_end" />
  </bpmn:process>
  <bpmn:process id="Process_system" isExecutable="false">
    <bpmn:startEvent id="system_start" name="มีผลประเมิน">
      <bpmn:outgoing>Flow_system_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="system_send_result" name="ส่งผลการประเมิน และการหักคะแนน ให้ผู้ยืม">
      <bpmn:incoming>Flow_system_1</bpmn:incoming>
      <bpmn:outgoing>Flow_system_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="system_gw_ev" name="">
      <bpmn:incoming>Flow_system_2</bpmn:incoming>
      <bpmn:outgoing>Flow_system_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="system_catch_appeal" name="รับคำอุทธรณ์">
      <bpmn:incoming>Flow_system_3</bpmn:incoming>
      <bpmn:outgoing>Flow_system_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_catch_appeal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="system_notify_sup" name="แจ้งเตือน อาจารย์ผู้ดูแล">
      <bpmn:incoming>Flow_system_6</bpmn:incoming>
      <bpmn:outgoing>Flow_system_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="system_wait_dec" name="รอผลพิจารณา">
      <bpmn:incoming>Flow_system_7</bpmn:incoming>
      <bpmn:outgoing>Flow_system_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_wait_dec" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="system_gw_dec" name="ผลพิจารณา?">
      <bpmn:incoming>Flow_system_8</bpmn:incoming>
      <bpmn:outgoing>Flow_system_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="system_timer" name="พ้นกำหนดยื่นอุทธรณ์">
      <bpmn:incoming>Flow_system_4</bpmn:incoming>
      <bpmn:outgoing>Flow_system_5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_system_timer" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="system_notify_keep" name="แจ้งผู้ยืม: ยืนผลเดิม">
      <bpmn:incoming>Flow_system_9</bpmn:incoming>
      <bpmn:outgoing>Flow_system_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="system_fork" name="">
      <bpmn:incoming>Flow_system_11</bpmn:incoming>
      <bpmn:outgoing>Flow_system_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="system_notify_user" name="แจ้งเตือนผู้ยืม">
      <bpmn:incoming>Flow_system_12</bpmn:incoming>
      <bpmn:outgoing>Flow_system_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="system_update" name="อัปเดตข้อมูล อุปกรณ์และผู้ยืม">
      <bpmn:incoming>Flow_system_13</bpmn:incoming>
      <bpmn:outgoing>Flow_system_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="system_join" name="">
      <bpmn:incoming>Flow_system_14</bpmn:incoming>
      <bpmn:incoming>Flow_system_15</bpmn:incoming>
      <bpmn:outgoing>Flow_system_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="system_end_ok" name="ปิดคำอุทธรณ์ (แก้ไขผลแล้ว)">
      <bpmn:incoming>Flow_system_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_system_1" name="" sourceRef="system_start" targetRef="system_send_result" />
    <bpmn:sequenceFlow id="Flow_system_2" name="" sourceRef="system_send_result" targetRef="system_gw_ev" />
    <bpmn:sequenceFlow id="Flow_system_3" name="" sourceRef="system_gw_ev" targetRef="system_catch_appeal" />
    <bpmn:sequenceFlow id="Flow_system_4" name="" sourceRef="system_gw_ev" targetRef="system_timer" />
    <bpmn:sequenceFlow id="Flow_system_5" name="" sourceRef="system_timer" targetRef="system_end_none" />
    <bpmn:sequenceFlow id="Flow_system_6" name="" sourceRef="system_catch_appeal" targetRef="system_notify_sup" />
    <bpmn:sequenceFlow id="Flow_system_7" name="" sourceRef="system_notify_sup" targetRef="system_wait_dec" />
    <bpmn:sequenceFlow id="Flow_system_8" name="" sourceRef="system_wait_dec" targetRef="system_gw_dec" />
    <bpmn:sequenceFlow id="Flow_system_9" name="ไม่เห็นชอบ" sourceRef="system_gw_dec" targetRef="system_notify_keep" />
    <bpmn:sequenceFlow id="Flow_system_10" name="" sourceRef="system_notify_keep" targetRef="system_end_keep" />
    <bpmn:sequenceFlow id="Flow_system_11" name="เห็นชอบ" sourceRef="system_gw_dec" targetRef="system_fork" />
    <bpmn:sequenceFlow id="Flow_system_12" name="" sourceRef="system_fork" targetRef="system_notify_user" />
    <bpmn:sequenceFlow id="Flow_system_13" name="" sourceRef="system_fork" targetRef="system_update" />
    <bpmn:sequenceFlow id="Flow_system_14" name="" sourceRef="system_notify_user" targetRef="system_join" />
    <bpmn:sequenceFlow id="Flow_system_15" name="" sourceRef="system_update" targetRef="system_join" />
    <bpmn:sequenceFlow id="Flow_system_16" name="" sourceRef="system_join" targetRef="system_end_ok" />
    <bpmn:endEvent id="system_end_none" name="ไม่มีการอุทธรณ์">
      <bpmn:incoming>Flow_system_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="system_end_keep" name="ปิดคำอุทธรณ์ (ยืนผลเดิม)">
      <bpmn:incoming>Flow_system_10</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_supervisor" isExecutable="false">
    <bpmn:startEvent id="supervisor_recv" name="รับแจ้งคำอุทธรณ์">
      <bpmn:outgoing>Flow_supervisor_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_supervisor_recv" />
    </bpmn:startEvent>
    <bpmn:userTask id="supervisor_review" name="ตรวจสอบรายละเอียดเหตุผลการการหักเครดิต">
      <bpmn:incoming>Flow_supervisor_1</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="supervisor_gw_dec" name="ผลพิจารณา?">
      <bpmn:incoming>Flow_supervisor_2</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_supervisor_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="supervisor_fix" name="แก้ไขผลประเมินเครดิต ให้ถูกต้อง ตามที่พิจารณา">
      <bpmn:incoming>Flow_supervisor_3</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="supervisor_send_agree" name="ส่งผล: เห็นชอบ">
      <bpmn:incoming>Flow_supervisor_5</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="supervisor_end_agree" name="จบการพิจารณา">
      <bpmn:incoming>Flow_supervisor_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="supervisor_send_disagree" name="ส่งผล: ไม่เห็นชอบ">
      <bpmn:incoming>Flow_supervisor_4</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_supervisor_1" name="" sourceRef="supervisor_recv" targetRef="supervisor_review" />
    <bpmn:sequenceFlow id="Flow_supervisor_2" name="" sourceRef="supervisor_review" targetRef="supervisor_gw_dec" />
    <bpmn:sequenceFlow id="Flow_supervisor_3" name="เห็นชอบ" sourceRef="supervisor_gw_dec" targetRef="supervisor_fix" />
    <bpmn:sequenceFlow id="Flow_supervisor_4" name="ไม่เห็นชอบ" sourceRef="supervisor_gw_dec" targetRef="supervisor_send_disagree" />
    <bpmn:sequenceFlow id="Flow_supervisor_5" name="" sourceRef="supervisor_fix" targetRef="supervisor_send_agree" />
    <bpmn:sequenceFlow id="Flow_supervisor_6" name="" sourceRef="supervisor_send_agree" targetRef="supervisor_end_agree" />
    <bpmn:sequenceFlow id="Flow_supervisor_7" name="" sourceRef="supervisor_send_disagree" targetRef="supervisor_end_disagree" />
    <bpmn:endEvent id="supervisor_end_disagree" name="จบการพิจารณา">
      <bpmn:incoming>Flow_supervisor_7</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_appeal">
    <bpmndi:BPMNPlane id="BPMNPlane_appeal" bpmnElement="Collaboration_appeal">
      <bpmndi:BPMNShape id="Participant_user_di" bpmnElement="Participant_user" isHorizontal="true">
