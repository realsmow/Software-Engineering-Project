<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_return" targetNamespace="http://ulms.cpe/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_return" name="กระบวนการคืนอุปกรณ์">
    <bpmn:participant id="Participant_user" name="ผู้ยืม (User)" processRef="Process_user" />
    <bpmn:participant id="Participant_system" name="ระบบ ULMs (System)" processRef="Process_system" />
    <bpmn:participant id="Participant_staff" name="เจ้าหน้าที่ (Staff)" processRef="Process_staff" />
    <bpmn:messageFlow id="MsgFlow_1" name="อุปกรณ์ที่นำมาคืน" sourceRef="user_bring" targetRef="staff_recv" />
    <bpmn:messageFlow id="MsgFlow_2" name="ผลการตรวจรับคืน" sourceRef="staff_send" targetRef="system_recv" />
    <bpmn:messageFlow id="MsgFlow_3" name="ผลการคืนและเครดิตที่ถูกหัก" sourceRef="system_notify" targetRef="user_wait" />
  </bpmn:collaboration>
  <bpmn:process id="Process_user" isExecutable="false">
    <bpmn:startEvent id="user_start" name="เริ่ม">
      <bpmn:outgoing>Flow_user_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="user_bring" name="นำอุปกรณ์มาคืน ณ จุดบริการ">
      <bpmn:incoming>Flow_user_1</bpmn:incoming>
      <bpmn:outgoing>Flow_user_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="user_wait" name="รับแจ้งผลการคืน">
      <bpmn:incoming>Flow_user_2</bpmn:incoming>
      <bpmn:outgoing>Flow_user_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_user_wait" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="user_end" name="จบการคืน">
      <bpmn:incoming>Flow_user_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_user_1" name="" sourceRef="user_start" targetRef="user_bring" />
    <bpmn:sequenceFlow id="Flow_user_2" name="" sourceRef="user_bring" targetRef="user_wait" />
    <bpmn:sequenceFlow id="Flow_user_3" name="" sourceRef="user_wait" targetRef="user_end" />
  </bpmn:process>
  <bpmn:process id="Process_system" isExecutable="false">
    <bpmn:startEvent id="system_recv" name="รับผลการตรวจรับคืน">
      <bpmn:outgoing>Flow_system_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_recv" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="system_gw_dmg" name="มีความเสียหาย?">
      <bpmn:incoming>Flow_system_1</bpmn:incoming>
      <bpmn:outgoing>Flow_system_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="system_discredit" name="คำนวณการหักเครดิต (Discredit)">
      <bpmn:incoming>Flow_system_2</bpmn:incoming>
      <bpmn:outgoing>Flow_system_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="system_merge" name="">
      <bpmn:incoming>Flow_system_3</bpmn:incoming>
      <bpmn:incoming>Flow_system_4</bpmn:incoming>
      <bpmn:outgoing>Flow_system_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="system_fork" name="">
      <bpmn:incoming>Flow_system_5</bpmn:incoming>
      <bpmn:outgoing>Flow_system_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="system_notify" name="แจ้งเตือนผู้ยืม">
      <bpmn:incoming>Flow_system_6</bpmn:incoming>
      <bpmn:outgoing>Flow_system_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="system_update" name="อัปเดตข้อมูล อุปกรณ์และผู้ยืม">
      <bpmn:incoming>Flow_system_7</bpmn:incoming>
      <bpmn:outgoing>Flow_system_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="system_join" name="">
      <bpmn:incoming>Flow_system_8</bpmn:incoming>
      <bpmn:incoming>Flow_system_9</bpmn:incoming>
      <bpmn:outgoing>Flow_system_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="system_end" name="ปิดรายการคืน">
      <bpmn:incoming>Flow_system_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_system_1" name="" sourceRef="system_recv" targetRef="system_gw_dmg" />
    <bpmn:sequenceFlow id="Flow_system_2" name="พบความเสียหาย" sourceRef="system_gw_dmg" targetRef="system_discredit" />
    <bpmn:sequenceFlow id="Flow_system_3" name="ไม่พบ" sourceRef="system_gw_dmg" targetRef="system_merge" />
    <bpmn:sequenceFlow id="Flow_system_4" name="" sourceRef="system_discredit" targetRef="system_merge" />
    <bpmn:sequenceFlow id="Flow_system_5" name="" sourceRef="system_merge" targetRef="system_fork" />
    <bpmn:sequenceFlow id="Flow_system_6" name="" sourceRef="system_fork" targetRef="system_notify" />
    <bpmn:sequenceFlow id="Flow_system_7" name="" sourceRef="system_fork" targetRef="system_update" />
    <bpmn:sequenceFlow id="Flow_system_8" name="" sourceRef="system_notify" targetRef="system_join" />
    <bpmn:sequenceFlow id="Flow_system_9" name="" sourceRef="system_update" targetRef="system_join" />
    <bpmn:sequenceFlow id="Flow_system_10" name="" sourceRef="system_join" targetRef="system_end" />
  </bpmn:process>
  <bpmn:process id="Process_staff" isExecutable="false">
    <bpmn:exclusiveGateway id="staff_gw_dmg" name="พบความเสียหาย?">
      <bpmn:incoming>Flow_1prki4r</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_staff_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="staff_assess" name="ประเมินระดับความเสียหาย (B0–B3) &#38; บันทึกผล">
      <bpmn:incoming>Flow_staff_6</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="staff_merge" name="">
      <bpmn:incoming>Flow_staff_7</bpmn:incoming>
      <bpmn:incoming>Flow_staff_8</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="staff_send" name="ส่งผลการตรวจรับ ให้ระบบ">
      <bpmn:incoming>Flow_staff_9</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="staff_end" name="จบงานรับคืน">
      <bpmn:incoming>Flow_staff_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_staff_6" name="ใช่" sourceRef="staff_gw_dmg" targetRef="staff_assess" />
    <bpmn:sequenceFlow id="Flow_staff_7" name="ไม่" sourceRef="staff_gw_dmg" targetRef="staff_merge" />
    <bpmn:sequenceFlow id="Flow_staff_8" name="" sourceRef="staff_assess" targetRef="staff_merge" />
    <bpmn:sequenceFlow id="Flow_staff_9" name="" sourceRef="staff_merge" targetRef="staff_send" />
    <bpmn:sequenceFlow id="Flow_staff_10" name="" sourceRef="staff_send" targetRef="staff_end" />
    <bpmn:sequenceFlow id="Flow_1hw6724" sourceRef="staff_recv" targetRef="staff_inspect" />
    <bpmn:sequenceFlow id="Flow_1prki4r" sourceRef="staff_confirm" targetRef="staff_gw_dmg" />
    <bpmn:userTask id="staff_confirm" name="กดยืนยัน การส่งคืนในแอป">
      <bpmn:incoming>Flow_0s78dkb</bpmn:incoming>
      <bpmn:outgoing>Flow_1prki4r</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="staff_photo" name="ถ่ายรูปอุปกรณ์ตอนคืน + อัปโหลดเข้าระบบ">
      <bpmn:incoming>Flow_0g87u9r</bpmn:incoming>
      <bpmn:outgoing>Flow_0s78dkb</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="staff_compare" name="เปรียบเทียบสภาพอุปกรณ์ก่อนและหลังคืน">
      <bpmn:incoming>Flow_1qdc1fh</bpmn:incoming>
      <bpmn:outgoing>Flow_0g87u9r</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="staff_inspect" name="ตรวจรับอุปกรณ์ &#38; จำนวน">
      <bpmn:incoming>Flow_1hw6724</bpmn:incoming>
      <bpmn:outgoing>Flow_1qdc1fh</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_0s78dkb" sourceRef="staff_photo" targetRef="staff_confirm" />
    <bpmn:sequenceFlow id="Flow_0g87u9r" sourceRef="staff_compare" targetRef="staff_photo" />
    <bpmn:sequenceFlow id="Flow_1qdc1fh" sourceRef="staff_inspect" targetRef="staff_compare" />
    <bpmn:startEvent id="staff_recv" name="รับคืนอุปกรณ์">
      <bpmn:outgoing>Flow_1hw6724</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_staff_recv" />
    </bpmn:startEvent>
  </bpmn:process>
