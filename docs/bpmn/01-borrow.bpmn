<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_borrow" targetNamespace="http://ulms.cpe/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_borrow" name="กระบวนการยืมอุปกรณ์">
    <bpmn:participant id="Participant_user" name="ผู้ยืม (User)" processRef="Process_user" />
    <bpmn:participant id="Participant_system" name="ระบบ ULMs (System)" processRef="Process_system" />
    <bpmn:participant id="Participant_staff" name="เจ้าหน้าที่ (Staff)" processRef="Process_staff" />
    <bpmn:participant id="Participant_supervisor" name="อาจารย์ผู้ดูแล (Supervisor)" processRef="Process_supervisor" />
    <bpmn:messageFlow id="MsgFlow_1" name="คำขอยืมอุปกรณ์" sourceRef="user_submit" targetRef="system_recv" />
    <bpmn:messageFlow id="MsgFlow_2" name="คำขอรออนุมัติ" sourceRef="system_ask_sup" targetRef="supervisor_recv" />
    <bpmn:messageFlow id="MsgFlow_3" name="ผลพิจารณา: อนุมัติ" sourceRef="supervisor_send_ok" targetRef="system_wait_dec" />
    <bpmn:messageFlow id="MsgFlow_4" name="ผลพิจารณา: ไม่อนุมัติ" sourceRef="supervisor_send_no" targetRef="system_wait_dec" />
    <bpmn:messageFlow id="MsgFlow_5" name="แจ้งผล: คำขอถูกปฏิเสธ" sourceRef="system_notify_rej" targetRef="user_wait_result" />
    <bpmn:messageFlow id="MsgFlow_6" name="แจ้งผล: อนุมัติ" sourceRef="system_notify_ok" targetRef="user_wait_result" />
    <bpmn:messageFlow id="MsgFlow_7" name="ใบจัดเตรียมอุปกรณ์" sourceRef="system_ask_staff" targetRef="staff_recv" />
    <bpmn:messageFlow id="MsgFlow_8" name="แจ้งว่าอุปกรณ์พร้อมรับ" sourceRef="staff_prepare" targetRef="user_wait_ready" />
    <bpmn:messageFlow id="MsgFlow_9" name="รูปถ่ายตอนรับอุปกรณ์" sourceRef="user_photo" targetRef="system_wait_photo" />
  </bpmn:collaboration>
  <bpmn:process id="Process_user" isExecutable="false">
    <bpmn:startEvent id="user_start" name="เริ่ม">
      <bpmn:outgoing>Flow_user_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="user_pick" name="เลือกอุปกรณ์ ที่ต้องการยืม">
      <bpmn:incoming>Flow_user_1</bpmn:incoming>
      <bpmn:outgoing>Flow_user_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="user_detail" name="ระบุจำนวน / วันยืม–คืน (เลือก Serial กรณี T2)">
      <bpmn:incoming>Flow_user_2</bpmn:incoming>
      <bpmn:outgoing>Flow_user_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="user_submit" name="ส่งคำขอยืมอุปกรณ์">
      <bpmn:incoming>Flow_user_3</bpmn:incoming>
      <bpmn:outgoing>Flow_user_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="user_wait_result" name="รอผลพิจารณาคำขอ">
      <bpmn:incoming>Flow_user_4</bpmn:incoming>
      <bpmn:outgoing>Flow_user_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_user_wait_result" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="user_gw_result" name="คำขอผ่านหรือไม่?">
      <bpmn:incoming>Flow_user_5</bpmn:incoming>
      <bpmn:outgoing>Flow_user_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_user_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="user_end_reject" name="คำขอถูกปฏิเสธ">
      <bpmn:incoming>Flow_user_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="user_wait_ready" name="อุปกรณ์พร้อมรับ">
      <bpmn:incoming>Flow_user_7</bpmn:incoming>
      <bpmn:outgoing>Flow_user_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_user_wait_ready" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="user_pickup" name="เดินทางมารับอุปกรณ์ ที่จุดบริการ">
      <bpmn:incoming>Flow_user_8</bpmn:incoming>
      <bpmn:outgoing>Flow_user_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="user_photo" name="ถ่ายรูปอุปกรณ์ตอนรับ + อัปโหลดเข้าระบบ">
      <bpmn:incoming>Flow_user_9</bpmn:incoming>
      <bpmn:outgoing>Flow_user_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="user_end_ok" name="รับอุปกรณ์เรียบร้อย">
      <bpmn:incoming>Flow_user_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_user_1" name="" sourceRef="user_start" targetRef="user_pick" />
    <bpmn:sequenceFlow id="Flow_user_2" name="" sourceRef="user_pick" targetRef="user_detail" />
    <bpmn:sequenceFlow id="Flow_user_3" name="" sourceRef="user_detail" targetRef="user_submit" />
    <bpmn:sequenceFlow id="Flow_user_4" name="" sourceRef="user_submit" targetRef="user_wait_result" />
    <bpmn:sequenceFlow id="Flow_user_5" name="" sourceRef="user_wait_result" targetRef="user_gw_result" />
    <bpmn:sequenceFlow id="Flow_user_6" name="ไม่ผ่าน" sourceRef="user_gw_result" targetRef="user_end_reject" />
    <bpmn:sequenceFlow id="Flow_user_7" name="ผ่าน" sourceRef="user_gw_result" targetRef="user_wait_ready" />
    <bpmn:sequenceFlow id="Flow_user_8" name="" sourceRef="user_wait_ready" targetRef="user_pickup" />
    <bpmn:sequenceFlow id="Flow_user_9" name="" sourceRef="user_pickup" targetRef="user_photo" />
    <bpmn:sequenceFlow id="Flow_user_10" name="" sourceRef="user_photo" targetRef="user_end_ok" />
  </bpmn:process>
  <bpmn:process id="Process_system" isExecutable="false">
    <bpmn:startEvent id="system_recv" name="รับคำขอยืม">
      <bpmn:outgoing>Flow_system_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_recv" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="system_check" name="ตรวจสอบสิทธิ์ / Credit / ของคงเหลือ">
      <bpmn:incoming>Flow_system_1</bpmn:incoming>
      <bpmn:outgoing>Flow_system_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="system_gw_pass" name="ผ่านเกณฑ์?">
      <bpmn:incoming>Flow_system_2</bpmn:incoming>
      <bpmn:outgoing>Flow_system_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="system_ask_sup" name="ส่งคำขอ ให้อาจารย์พิจารณา">
      <bpmn:incoming>Flow_system_5</bpmn:incoming>
      <bpmn:outgoing>Flow_system_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="system_wait_dec" name="รอผลพิจารณา">
      <bpmn:incoming>Flow_system_7</bpmn:incoming>
      <bpmn:outgoing>Flow_system_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_wait_dec" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="system_gw_dec" name="ผลพิจารณา?">
      <bpmn:incoming>Flow_system_8</bpmn:incoming>
      <bpmn:outgoing>Flow_system_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="system_merge_ok" name="">
      <bpmn:incoming>Flow_system_6</bpmn:incoming>
      <bpmn:incoming>Flow_system_9</bpmn:incoming>
      <bpmn:outgoing>Flow_system_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="system_notify_ok" name="แจ้งเตือนผู้ยืม (อนุมัติ)">
      <bpmn:incoming>Flow_system_14</bpmn:incoming>
      <bpmn:outgoing>Flow_system_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="system_join" name="">
      <bpmn:incoming>Flow_system_16</bpmn:incoming>
      <bpmn:incoming>Flow_system_17</bpmn:incoming>
      <bpmn:outgoing>Flow_system_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="system_ask_staff" name="แจ้งเจ้าหน้าที่ จัดเตรียมอุปกรณ์">
      <bpmn:incoming>Flow_system_18</bpmn:incoming>
      <bpmn:outgoing>Flow_system_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="system_wait_photo" name="รอรูปถ่ายตอนรับ">
      <bpmn:incoming>Flow_system_19</bpmn:incoming>
      <bpmn:outgoing>Flow_system_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_system_wait_photo" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="system_set_inuse" name="เปลี่ยนสถานะอุปกรณ์ เป็น IN USE">
      <bpmn:incoming>Flow_system_20</bpmn:incoming>
      <bpmn:outgoing>Flow_system_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="system_end_ok" name="คำขอสมบูรณ์">
      <bpmn:incoming>Flow_system_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="system_merge_rej" name="">
      <bpmn:incoming>Flow_system_4</bpmn:incoming>
      <bpmn:incoming>Flow_system_10</bpmn:incoming>
      <bpmn:outgoing>Flow_system_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="system_notify_rej" name="แจ้งผลปฏิเสธ ให้ผู้ยืม">
      <bpmn:incoming>Flow_system_11</bpmn:incoming>
      <bpmn:outgoing>Flow_system_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="system_end_rej" name="ปิดคำขอ">
      <bpmn:incoming>Flow_system_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_system_1" name="" sourceRef="system_recv" targetRef="system_check" />
    <bpmn:sequenceFlow id="Flow_system_2" name="" sourceRef="system_check" targetRef="system_gw_pass" />
    <bpmn:sequenceFlow id="Flow_system_3" name="ผ่านเกณฑ์" sourceRef="system_gw_pass" targetRef="system_gw_appr" />
    <bpmn:sequenceFlow id="Flow_system_4" name="ไม่ผ่านเกณฑ์" sourceRef="system_gw_pass" targetRef="system_merge_rej" />
    <bpmn:sequenceFlow id="Flow_system_5" name="ใช่" sourceRef="system_gw_appr" targetRef="system_ask_sup" />
    <bpmn:sequenceFlow id="Flow_system_6" name="ไม่" sourceRef="system_gw_appr" targetRef="system_merge_ok" />
    <bpmn:sequenceFlow id="Flow_system_7" name="" sourceRef="system_ask_sup" targetRef="system_wait_dec" />
    <bpmn:sequenceFlow id="Flow_system_8" name="" sourceRef="system_wait_dec" targetRef="system_gw_dec" />
    <bpmn:sequenceFlow id="Flow_system_9" name="อนุมัติ" sourceRef="system_gw_dec" targetRef="system_merge_ok" />
    <bpmn:sequenceFlow id="Flow_system_10" name="ไม่อนุมัติ" sourceRef="system_gw_dec" targetRef="system_merge_rej" />
    <bpmn:sequenceFlow id="Flow_system_11" name="" sourceRef="system_merge_rej" targetRef="system_notify_rej" />
    <bpmn:sequenceFlow id="Flow_system_12" name="" sourceRef="system_notify_rej" targetRef="system_end_rej" />
    <bpmn:sequenceFlow id="Flow_system_13" name="" sourceRef="system_merge_ok" targetRef="system_fork" />
    <bpmn:sequenceFlow id="Flow_system_14" name="" sourceRef="system_fork" targetRef="system_notify_ok" />
    <bpmn:sequenceFlow id="Flow_system_15" name="" sourceRef="system_fork" targetRef="system_update_status" />
    <bpmn:sequenceFlow id="Flow_system_16" name="" sourceRef="system_notify_ok" targetRef="system_join" />
    <bpmn:sequenceFlow id="Flow_system_17" name="" sourceRef="system_update_status" targetRef="system_join" />
    <bpmn:sequenceFlow id="Flow_system_18" name="" sourceRef="system_join" targetRef="system_ask_staff" />
    <bpmn:sequenceFlow id="Flow_system_19" name="" sourceRef="system_ask_staff" targetRef="system_wait_photo" />
    <bpmn:sequenceFlow id="Flow_system_20" name="" sourceRef="system_wait_photo" targetRef="system_set_inuse" />
    <bpmn:sequenceFlow id="Flow_system_21" name="" sourceRef="system_set_inuse" targetRef="system_end_ok" />
    <bpmn:serviceTask id="system_update_status" name="อัปเดตสถานะคำขอ เป็น &#34;อนุมัติ&#34;">
      <bpmn:incoming>Flow_system_15</bpmn:incoming>
      <bpmn:outgoing>Flow_system_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="system_fork" name="">
      <bpmn:incoming>Flow_system_13</bpmn:incoming>
      <bpmn:outgoing>Flow_system_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="system_gw_appr" name="ต้องขออนุมัติ?">
      <bpmn:incoming>Flow_system_3</bpmn:incoming>
      <bpmn:outgoing>Flow_system_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_system_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:textAnnotation id="system_rule_appr">
      <bpmn:text>ต้องขออนุมัติเมื่อ: อุปกรณ์ระดับ T2 หรือ อุปกรณ์ระดับ T1 ที่ระดับการยืม อยู่ใน D2/D3</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_system_rule_appr" sourceRef="system_gw_appr" targetRef="system_rule_appr" />
  </bpmn:process>
  <bpmn:process id="Process_staff" isExecutable="false">
    <bpmn:startEvent id="staff_recv" name="รับแจ้งให้จัดเตรียม">
      <bpmn:outgoing>Flow_staff_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_staff_recv" />
    </bpmn:startEvent>
    <bpmn:manualTask id="staff_prepare" name="จัดเตรียมอุปกรณ์ ตาม Serial/รายการ">
      <bpmn:incoming>Flow_staff_1</bpmn:incoming>
      <bpmn:outgoing>Flow_staff_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="staff_end" name="อุปกรณ์พร้อมส่งมอบ">
      <bpmn:incoming>Flow_staff_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_staff_1" name="" sourceRef="staff_recv" targetRef="staff_prepare" />
    <bpmn:sequenceFlow id="Flow_staff_2" name="" sourceRef="staff_prepare" targetRef="staff_end" />
  </bpmn:process>
  <bpmn:process id="Process_supervisor" isExecutable="false">
    <bpmn:startEvent id="supervisor_recv" name="รับคำขออนุมัติ">
      <bpmn:outgoing>Flow_supervisor_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_supervisor_recv" />
    </bpmn:startEvent>
    <bpmn:userTask id="supervisor_review" name="ตรวจสอบรายละเอียดคำขอ &#38; เหตุผลการใช้งาน">
      <bpmn:incoming>Flow_supervisor_1</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="supervisor_gw_dec" name="ผลพิจารณา?">
      <bpmn:incoming>Flow_supervisor_2</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_supervisor_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="supervisor_send_ok" name="แจ้งผลอนุมัติ">
      <bpmn:incoming>Flow_supervisor_3</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="supervisor_end_ok" name="จบการพิจารณา">
      <bpmn:incoming>Flow_supervisor_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_supervisor_1" name="" sourceRef="supervisor_recv" targetRef="supervisor_review" />
    <bpmn:sequenceFlow id="Flow_supervisor_2" name="" sourceRef="supervisor_review" targetRef="supervisor_gw_dec" />
    <bpmn:sequenceFlow id="Flow_supervisor_3" name="อนุมัติ" sourceRef="supervisor_gw_dec" targetRef="supervisor_send_ok" />
    <bpmn:sequenceFlow id="Flow_supervisor_4" name="ไม่อนุมัติ" sourceRef="supervisor_gw_dec" targetRef="supervisor_send_no" />
    <bpmn:sequenceFlow id="Flow_supervisor_5" name="" sourceRef="supervisor_send_ok" targetRef="supervisor_end_ok" />
    <bpmn:sequenceFlow id="Flow_supervisor_6" name="" sourceRef="supervisor_send_no" targetRef="supervisor_end_no" />
    <bpmn:sendTask id="supervisor_send_no" name="แจ้งผลไม่อนุมัติ">
      <bpmn:incoming>Flow_supervisor_4</bpmn:incoming>
      <bpmn:outgoing>Flow_supervisor_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="supervisor_end_no" name="จบการพิจารณา">
      <bpmn:incoming>Flow_supervisor_6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_borrow">
    <bpmndi:BPMNPlane id="BPMNPlane_borrow" bpmnElement="Collaboration_borrow">
      <bpmndi:BPMNShape id="Participant_user_di" bpmnElement="Participant_user" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="4270" height="294" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_start_di" bpmnElement="user_start">
        <dc:Bounds x="224" y="146" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="234" y="185" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_pick_di" bpmnElement="user_pick">
        <dc:Bounds x="322" y="120" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_detail_di" bpmnElement="user_detail">
        <dc:Bounds x="548" y="120" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_submit_di" bpmnElement="user_submit">
        <dc:Bounds x="772" y="120" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_wait_result_di" bpmnElement="user_wait_result">
        <dc:Bounds x="2920" y="146" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2894" y="122" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_gw_result_di" bpmnElement="user_gw_result" isMarkerVisible="true">
        <dc:Bounds x="3078" y="140" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3018" y="108" width="168" height="22" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_end_reject_di" bpmnElement="user_end_reject">
        <dc:Bounds x="3310" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_wait_ready_di" bpmnElement="user_wait_ready">
        <dc:Bounds x="3474" y="146" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3455" y="133" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_pickup_di" bpmnElement="user_pickup">
        <dc:Bounds x="3572" y="120" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_photo_di" bpmnElement="user_photo">
        <dc:Bounds x="3798" y="120" width="170" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="user_end_ok_di" bpmnElement="user_end_ok">
