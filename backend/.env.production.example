# Copy to backend/.env.production and fill in real values.
# Placeholders only - never commit real values.

# ==================== Server ====================
NODE_ENV=production
PORT=3000

# ==================== Database ====================
# Host is `postgres` - the service name in docker-compose.prod.yml, not
# localhost. Password must match POSTGRES_PASSWORD in the compose environment.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/app"

# ==================== Auth / Session ====================
# Required - the server refuses to boot without a value >= 32 characters.
# Generate: openssl rand -base64 48
SESSION_SECRET=""
SESSION_TTL_HOURS=12

# Must be true in production (HTTPS only). Put a TLS-terminating reverse
# proxy (Caddy/Traefik/host nginx) in front, or cookies never get set.
COOKIE_SECURE=true

# Comma-separated frontend origins allowed to send the session cookie.
# Required - the server refuses to boot without it.
CORS_ORIGINS=https://ulms.example.ac.th

# 'lax' works while frontend and API share a site (this stack does, via the
# nginx reverse proxy). Only becomes 'none' if you split them across domains.
COOKIE_SAMESITE=lax

# ==================== File uploads ====================
# Mounted as a volume in docker-compose.prod.yml (backend_media -> /app/media).
MEDIA_ROOT=/app/media
# The address the BROWSER reaches the API at (through the reverse proxy),
# not the in-container address - it is baked into upload URLs handed to
# the browser.
PUBLIC_API_URL=https://ulms.example.ac.th

# ==================== Mail ====================
# leave empty to keep disabled - password reset / registration mail is
# skipped without a configured SMTP relay.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ULMs <no-reply@ku.th>"
# The real frontend origin - reset links point here.
PUBLIC_APP_URL=https://ulms.example.ac.th

# ==================== First-run seed (npm run seed:prod) ====================
# Used once, by `docker compose -f docker-compose.prod.yml exec backend node dist/src/seed-prod.js`
# to create reference data and the first admin account.
ADMIN_EMAIL=admin@ku.th
ADMIN_USER_ID=REPLACE_WITH_ADMIN_STUDENT_OR_STAFF_ID
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ==================== Google OAuth (optional - leave empty to keep disabled) ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Comma-separated list of email domains allowed to sign in via Google.
ALLOWED_EMAIL_DOMAINS=ku.th

# ==================== Term settings (optional - leave empty to keep disabled) ====================
TERM_END_DATE=YYYY-MM-DD

# Proxies between the browser and the backend: 1 = frontend nginx only,
# 2 = a TLS proxy (Caddy / host nginx) in front of it. Wrong value = every
# visitor shares one rate-limit bucket, or clients can spoof their IP.
TRUST_PROXY_HOPS=2
