// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// Enums
// =========================================================

enum GroupType {
  Club
  Faculty
}

enum ResourceStatus {
  InStorage
  Lending
  Missing
}

enum ResourceType {
  Room
  Item
}

enum ConditionStatus {
  Usable
  MinorDamage
  Broken
  Missing
}

enum ApproveStatus {
  Pending
  Approved
  Denied
  Canceled
}

enum CurrentStatus {
  Pending
  Prepared
  Lended
  Returned
  Inspected
}

enum PenaltyReason {
  DamagedItem
  BrokenItem
  LostItem
  DidntReturn
  ReturnLate
}

enum Verdict {
  NoProblem
  MinorDamage
  SignificantDamage
  Broken
}

enum PenaltyStatus {
  InEffect
  Appealed
  Ended
}

enum NotificationType {
  Announcement
  Approval
  Warning
}

enum SubmissionType {
  BeforePicture
  AfterPicture
  InspectionPicture
}

// =========================================================
// Accounts
// =========================================================

model Account {
  AccountKey     Int     @id @default(autoincrement())
  Email          String  @db.VarChar(256)
  HashedPassword String  @db.VarChar(256)
  AccountID      String  @db.VarChar(256)
  FName          String  @db.VarChar(256)
  LName          String  @db.VarChar(256)
  Credit         Int
  IsAdmin        Boolean @default(false)
  IsSuspended    Boolean @default(false)

  Authorities                Authority[]
  ConditionsChecked          Condition[]        @relation("ConditionCheckedBy")
  ReservationsReserved       Reservation[]      @relation("ReservationReservedBy")
  ReservationsApproved       Reservation[]      @relation("ReservationApprovedBy")
  UsagesUsed                 Usage[]            @relation("UsageUsedBy")
  ExtensionRequestsRequested ExtensionRequest[] @relation("ExtensionRequestRequestedBy")
  ExtensionRequestsApproved  ExtensionRequest[] @relation("ExtensionRequestApprovedBy")
  Inspections                Inspection[]       @relation("InspectionInspectedBy")
  Repairs                    Repair[]           @relation("RepairRepairedBy")
  Penalties                  Penalty[]
  AppealsFiled               Appeal[]           @relation("AppealFiledBy")
  AppealsResolved            Appeal[]           @relation("AppealResolvedBy")
  Images                     Image[]            @relation("ImageSubmittedBy")
  Notifications              Notification[]
}

// =========================================================
// Management
// =========================================================

model ManagementGroup {
  ManageGroupKey Int       @id @default(autoincrement())
  GroupType      GroupType

  Branch        Branch?
  Club          Club?
  Authorities   Authority[]
  Resources     Resource[]
  Eligibilities Eligibility[]
}

model Branch {
  BranchKey      Int     @id @default(autoincrement())
  ManageGroupKey Int     @unique
  FacultyKey     Int?
  BranchName     String? @db.VarChar(256)

  ManagementGroup ManagementGroup @relation(fields: [ManageGroupKey], references: [ManageGroupKey])
  Faculty         Faculty?        @relation(fields: [FacultyKey], references: [FacultyKey])
}

model Faculty {
  FacultyKey  Int     @id @default(autoincrement())
  FacultyName String? @db.VarChar(256)

  Branches Branch[]
}

model Club {
  ClubKey        Int     @id @default(autoincrement())
  ManageGroupKey Int     @unique
  ClubName       String? @db.VarChar(256)

  ManagementGroup ManagementGroup @relation(fields: [ManageGroupKey], references: [ManageGroupKey])
}

model Authority {
  AuthorityKey     Int @id @default(autoincrement())
  AccountKey       Int
  ManageGroupKey   Int
  AuthorityRoleKey Int

  Account         Account         @relation(fields: [AccountKey], references: [AccountKey])
  ManagementGroup ManagementGroup @relation(fields: [ManageGroupKey], references: [ManageGroupKey])
  AuthorityRole   AuthorityRole   @relation(fields: [AuthorityRoleKey], references: [AuthorityRoleKey])

  @@unique([AccountKey, ManageGroupKey])
}

model AuthorityRole {
  AuthorityRoleKey Int     @id @default(autoincrement())
  AuthorityName    String
  AuthorityLevel   Int?

  Authorities   Authority[]
  Eligibilities Eligibility[]
}

// =========================================================
// Resource
// =========================================================

model Resource {
  ResourceKey         Int            @id @default(autoincrement())
  ManageGroupKey      Int
  BorrowRuleKey       Int
  ConditionKey        Int?           @unique
  ResourceStatus      ResourceStatus
  ResourceType        ResourceType
  ResourceDescription String?
  BufferTime          Int
  IsBorrowAllowed     Boolean        @default(false)

  ManagementGroup  ManagementGroup @relation(fields: [ManageGroupKey], references: [ManageGroupKey])
  BorrowRule       BorrowRule      @relation(fields: [BorrowRuleKey], references: [BorrowRuleKey])
  CurrentCondition Condition?      @relation("ResourceCurrentCondition", fields: [ConditionKey], references: [ConditionKey])

  ItemUnit      ItemUnit?
  Room          Room?
  Conditions    Condition[]   @relation("ConditionResource")
  Eligibilities Eligibility[]
  Reservations  Reservation[]
  Usages        Usage[]
  Inspections   Inspection[]
  Repairs       Repair[]
  Images        Image[]
}

model ItemUnit {
  ItemUnitKey Int     @id @default(autoincrement())
  ResourceKey Int     @unique
  ItemKey     Int
  ItemID      String  @db.VarChar(256)
  IsDeleted   Boolean @default(false)

  Resource Resource @relation(fields: [ResourceKey], references: [ResourceKey])
  Item     Item     @relation(fields: [ItemKey], references: [ItemKey])
}

model Item {
  ItemKey      Int     @id @default(autoincrement())
  ItemName     String? @db.VarChar(256)
  ItemDesc     String?
  CreditWeight Float
  IsDeleted    Boolean @default(false)

  ItemUnits ItemUnit[]
}

model Room {
  RoomKey      Int     @id @default(autoincrement())
  ResourceKey  Int     @unique
  RoomName     String? @db.VarChar(256)
  RoomLocation String? @db.VarChar(256)
  CreditWeight Float
  IsDeleted    Boolean @default(false)

  Resource Resource @relation(fields: [ResourceKey], references: [ResourceKey])
}

model Condition {
  ConditionKey         Int             @id @default(autoincrement())
  ResourceKey          Int
  AccountKey_Checkedby Int
  ConditionStatus      ConditionStatus
  Notes                String?
  CheckedAt            DateTime

  Resource         Resource @relation("ConditionResource", fields: [ResourceKey], references: [ResourceKey])
  CheckedByAccount Account  @relation("ConditionCheckedBy", fields: [AccountKey_Checkedby], references: [AccountKey])

  CurrentForResource Resource?    @relation("ResourceCurrentCondition")
  Inspections        Inspection[]
  RepairsBefore      Repair[]     @relation("RepairConditionBefore")
  RepairsAfter       Repair[]     @relation("RepairConditionAfter")
  UsagesCheckout     Usage[]      @relation("UsageConditionCheckout")
  UsagesCheckIn      Usage[]      @relation("UsageConditionCheckIn")
}

model BorrowRule {
  BorrowRuleKey Int     @id @default(autoincrement())
  RuleName      String? @db.VarChar(256)

  Resources         Resource[]
  PenaltyRules      PenaltyRule[]
  BorrowConstraints BorrowConstraint[]
}

model BorrowConstraint {
  BorrowConstraintKey  Int @id @default(autoincrement())
  BorrowRuleKey        Int
  CreditTierKey        Int
  MinimumAuthorityLevel Int?
  MaxBorrowDate        Int
  MaxExtendTime        Int

  BorrowRule BorrowRule @relation(fields: [BorrowRuleKey], references: [BorrowRuleKey])
  CreditTier CreditTier @relation(fields: [CreditTierKey], references: [CreditTierKey])

  @@unique([BorrowRuleKey, CreditTierKey])
}

model PenaltyRule {
  PenaltyRuleKey    Int           @id @default(autoincrement())
  BorrowRuleKey     Int
  CreditDeducted    Int
  PenaltyTimeLength Int
  PenaltyReason     PenaltyReason

  BorrowRule BorrowRule @relation(fields: [BorrowRuleKey], references: [BorrowRuleKey])

  @@unique([BorrowRuleKey, PenaltyReason])
}

model Eligibility {
  EligibilityKey   Int @id @default(autoincrement())
  ResourceKey      Int
  ManageGroupKey   Int
  AuthorityRoleKey Int

  Resource        Resource        @relation(fields: [ResourceKey], references: [ResourceKey])
  ManagementGroup ManagementGroup @relation(fields: [ManageGroupKey], references: [ManageGroupKey])
  AuthorityRole   AuthorityRole   @relation(fields: [AuthorityRoleKey], references: [AuthorityRoleKey])

  @@unique([ManageGroupKey, ResourceKey, AuthorityRoleKey])
}

model CreditTier {
  CreditTierKey  Int     @id @default(autoincrement())
  CreditTierName String?
  CreditMin      Int
  CreditMax      Int

  BorrowConstraints BorrowConstraint[]
}

// =========================================================
// Reservation / Usage
// =========================================================

model Reservation {
  ReservationKey        Int           @id @default(autoincrement())
  ResourceKey           Int
  AccountKey_Reservedby Int
  Reason                String?       @db.VarChar(256)
  StartTime             DateTime
  EndTime               DateTime
  ActionTime            DateTime
  ApproveStatus         ApproveStatus
  AccountKey_Approvedby Int?
  ReservationExpiration DateTime
  ResolvedAt            DateTime?

  Resource          Resource @relation(fields: [ResourceKey], references: [ResourceKey])
  ReservedByAccount Account  @relation("ReservationReservedBy", fields: [AccountKey_Reservedby], references: [AccountKey])
  ApprovedByAccount Account? @relation("ReservationApprovedBy", fields: [AccountKey_Approvedby], references: [AccountKey])

  Usages  Usage[]
  Repairs Repair[]
}

model Usage {
  UsageKey                    Int           @id @default(autoincrement())
  ReservationKey               Int?
  AccountKey_Usedby            Int
  ResourceKey                  Int
  CurrentStatus                 CurrentStatus
  DueTime                       DateTime
  ExtensionRequestKey_Pending   Int?          @unique
  CheckoutTime                  DateTime
  CheckInTime                   DateTime?
  ConditionKey_Checkout         Int
  ConditionKey_CheckIn          Int?

  Reservation       Reservation?      @relation(fields: [ReservationKey], references: [ReservationKey])
  UsedByAccount     Account           @relation("UsageUsedBy", fields: [AccountKey_Usedby], references: [AccountKey])
  Resource          Resource          @relation(fields: [ResourceKey], references: [ResourceKey])
  PendingExtension  ExtensionRequest? @relation("UsagePendingExtension", fields: [ExtensionRequestKey_Pending], references: [ExtensionRequestKey])
  CheckoutCondition Condition         @relation("UsageConditionCheckout", fields: [ConditionKey_Checkout], references: [ConditionKey])
  CheckInCondition  Condition?        @relation("UsageConditionCheckIn", fields: [ConditionKey_CheckIn], references: [ConditionKey])

  ExtensionRequests ExtensionRequest[] @relation("ExtensionRequestUsage")
  Inspections       Inspection[]
  Penalties         Penalty[]
  Images            Image[]
}

model ExtensionRequest {
  ExtensionRequestKey    Int           @id @default(autoincrement())
  UsageKey               Int
  AccountKey_Requestedby Int
  ExtendNo               Int?
  PreviousDueTime        DateTime
  RequestedDueTime       DateTime
  RequestedAt            DateTime
  ApproveStatus          ApproveStatus
  AccountKey_Approvedby  Int?
  ResolvedAt             DateTime?

  Usage              Usage    @relation("ExtensionRequestUsage", fields: [UsageKey], references: [UsageKey])
  RequestedByAccount Account  @relation("ExtensionRequestRequestedBy", fields: [AccountKey_Requestedby], references: [AccountKey])
  ApprovedByAccount  Account? @relation("ExtensionRequestApprovedBy", fields: [AccountKey_Approvedby], references: [AccountKey])

  PendingForUsage Usage? @relation("UsagePendingExtension")
}

// =========================================================
// Inspections
// =========================================================

model Inspection {
  InspectionKey          Int      @id @default(autoincrement())
  UsageKey                Int
  ResourceKey              Int
  AccountKey_Inspectedby   Int
  ConditionKey             Int
  Verdict                  Verdict
  AppealKey                Int?
  PenaltyKey                Int?
  ActionTime                 DateTime
  Notes                       String?

  Usage              Usage     @relation(fields: [UsageKey], references: [UsageKey])
  Resource           Resource  @relation(fields: [ResourceKey], references: [ResourceKey])
  InspectedByAccount Account   @relation("InspectionInspectedBy", fields: [AccountKey_Inspectedby], references: [AccountKey])
  Condition          Condition @relation(fields: [ConditionKey], references: [ConditionKey])

  Images Image[]
}

// =========================================================
// Penalty / Appeal
// =========================================================

model Penalty {
  PenaltyKey     Int           @id @default(autoincrement())
  AccountKey     Int
  UsageKey       Int?
  Reason         String?
  CreditDeducted Int           @default(0)
  ActionTime     DateTime
  ExpirationDate DateTime
  PenaltyStatus  PenaltyStatus @default(Ended)
  AppealKey      Int?
  IsDeleted      Boolean       @default(false)

  Account Account @relation(fields: [AccountKey], references: [AccountKey])
  Usage   Usage?  @relation(fields: [UsageKey], references: [UsageKey])
  Appeal  Appeal? @relation("PenaltyAppeal", fields: [AppealKey], references: [AppealKey])

  OriginalAppeal Appeal?  @relation("AppealOriginalPenalty")
  NewAppeals     Appeal[] @relation("AppealNewPenalty")
}

model Appeal {
  AppealKey             Int           @id @default(autoincrement())
  PenaltyKey_Original   Int           @unique
  PenaltyKey_New        Int?
  AccountKey_Filedby    Int
  ActionTime            DateTime?
  AccountKey_Resolvedby Int?
  AppealReason          String?
  ApproveStatus         ApproveStatus
  ResolvedAt            DateTime?

  OriginalPenalty   Penalty  @relation("AppealOriginalPenalty", fields: [PenaltyKey_Original], references: [PenaltyKey])
  NewPenalty        Penalty? @relation("AppealNewPenalty", fields: [PenaltyKey_New], references: [PenaltyKey])
  FiledByAccount    Account  @relation("AppealFiledBy", fields: [AccountKey_Filedby], references: [AccountKey])
  ResolvedByAccount Account? @relation("AppealResolvedBy", fields: [AccountKey_Resolvedby], references: [AccountKey])

  Penalties Penalty[] @relation("PenaltyAppeal")
}

// =========================================================
// Image System
// =========================================================

model Image {
  ImageKey               Int            @id @default(autoincrement())
  AccountKey_Submittedby Int
  UsageKey               Int
  ResourceKey            Int
  InspectionKey          Int?
  ImageURL               String         @db.VarChar(256)
  SubmissionType         SubmissionType
  ActionTime             DateTime
  IsDeleted              Boolean        @default(false)

  SubmittedByAccount Account     @relation("ImageSubmittedBy", fields: [AccountKey_Submittedby], references: [AccountKey])
  Usage              Usage       @relation(fields: [UsageKey], references: [UsageKey])
  Resource           Resource    @relation(fields: [ResourceKey], references: [ResourceKey])
  Inspection         Inspection? @relation(fields: [InspectionKey], references: [InspectionKey])
}

// =========================================================
// Notification
// =========================================================

model Notification {
  NotificationKey     Int              @id @default(autoincrement())
  AccountKey          Int
  NotificationType    NotificationType
  NotificationContent String
  SentTime            DateTime
  IsRead              Boolean          @default(false)
  IsDeleted           Boolean          @default(false)

  Account Account @relation(fields: [AccountKey], references: [AccountKey])
}

// =========================================================
// Repair
// =========================================================

model Repair {
  RepairKey                 Int       @id @default(autoincrement())
  ReservationKey             Int?
  AccountKey_Repairedby      Int
  ResourceKey                 Int
  BeginRepairDate               DateTime
  EndRepairDate                   DateTime?
  ConditionKey_BeforeRepair         Int
  ConditionKey_AfterRepair           Int?

  Reservation       Reservation? @relation(fields: [ReservationKey], references: [ReservationKey])
  RepairedByAccount Account      @relation("RepairRepairedBy", fields: [AccountKey_Repairedby], references: [AccountKey])
  Resource          Resource     @relation(fields: [ResourceKey], references: [ResourceKey])
  ConditionBefore   Condition    @relation("RepairConditionBefore", fields: [ConditionKey_BeforeRepair], references: [ConditionKey])
  ConditionAfter    Condition?   @relation("RepairConditionAfter", fields: [ConditionKey_AfterRepair], references: [ConditionKey])
}
