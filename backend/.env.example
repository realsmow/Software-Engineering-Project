# ---------------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า —  .env ถูก gitignore ไว้แล้ว
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Postgres — docker-compose.yml ในโฟลเดอร์นี้ตั้งค่าตรงกับ URL ข้างล่างพอดี
#     docker compose up -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# กุญแจสำหรับเซ็น cookie ชื่อ ulms_session
#
# ต้องยาวอย่างน้อย 32 ตัวอักษร  ถ้าไม่ตั้ง: ตอน dev จะสุ่มให้ใหม่ทุกครั้งที่
# restart (คือทุกคนหลุด login) ส่วนตอน NODE_ENV=production จะไม่ยอมสตาร์ทเลย
#
# สร้างค่าใหม่:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# อายุ session (ชั่วโมง) — token เพิกถอนกลางคันไม่ได้ ดู docs/auth-admin.md
SESSION_TTL_HOURS=12

# แอตทริบิวต์ของ cookie
#
# 'lax' พอสำหรับตอน dev เพราะ localhost:5173 กับ localhost:3000 นับเป็น site
# เดียวกัน (คนละ port ไม่นับ)  แต่ถ้า production แยกโดเมนกันเมื่อไหร่ ต้องเป็น
# COOKIE_SAMESITE=none + COOKIE_SECURE=true ไม่งั้น browser จะทิ้ง cookie เงียบ ๆ
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

PORT=3000
NODE_ENV=development
