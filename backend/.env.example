# Copy to .env and fill in. Placeholders only - never commit real values.
# Every variable here is read by code somewhere; nothing aspirational.

# ==================== Server ====================
NODE_ENV=development
PORT=3000

# ==================== Database ====================
# User/password/db must match backend/docker-compose.yml (POSTGRES_DB: app).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# ==================== Auth / Session ====================
# Required in production - the server refuses to boot without it, and a value
# shorter than 32 characters is ignored. Dev falls back to a random
# per-process secret, so every restart logs everyone out.
# Generate: openssl rand -base64 48
SESSION_SECRET=""
SESSION_TTL_HOURS=12

# true in production (HTTPS only); forced true when NODE_ENV=production.
COOKIE_SECURE=false
# Comma-separated frontend origins allowed to send the session cookie.
# localhost:5173 and :4173 are always allowed in development. Required in
# production, where the server refuses to boot without it rather than blocking
# every request from the real frontend and looking like an outage.
# CORS_ORIGINS=https://ulms.example.ac.th

# 'lax' works while the frontend shares a site with the API. Split them across
# domains and this must become 'none' with COOKIE_SECURE=true, or the browser
# drops the cookie on every request.
COOKIE_SAMESITE=lax

# ==================== Google OAuth (FR-AUTH-01/02) ====================
# "Sign in with Google" for KU accounts. READY TO WIRE LATER - no real
# credentials exist yet. The feature stays off (GET /auth/google answers 404,
# auth.providers reports google:false) until all three of GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI below are set.
#
# Create these in Google Cloud Console > APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application. The authorized
# redirect URI registered there must equal GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# C-01: which e-mail domains may hold an account at all. Comma-separated;
# checked on self-registration and on a verified Google identity alike.
# Never applied to admin-created local accounts or to signing in with an
# account that already exists. Defaults to ku.th when unset.
ALLOWED_EMAIL_DOMAINS=ku.th

# ==================== File uploads ====================
# Where uploaded images are written, and the base URL they are served from.
# Upload tickets are signed with SESSION_SECRET above, so changing that
# invalidates any upload URL already handed out.
#
# PUBLIC_API_URL must be the address the BROWSER can reach — it is baked into
# the upload URL the browser PUTs to, so 'localhost' inside a container is
# wrong here even when it works for the server itself.
MEDIA_ROOT=./media
PUBLIC_API_URL=http://localhost:3000

# ==================== Mail ====================
# Password reset and registration mail. Defaults are the MailHog container
# (localhost:1025, no login). A real relay needs a login, and port 465 needs
# SMTP_SECURE=true; 587 upgrades to TLS by itself.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ULMs <no-reply@ku.th>"
# The frontend address the links in those mails point at. Must be the real
# site in production, or every reset link opens localhost.
PUBLIC_APP_URL=http://localhost:5173

# ==================== Reservations ====================
# Last Bangkok day of the current term a T1/T2 request may end on (FR-RSV-01). Unset = no cap here.
# TERM_END_DATE=2026-12-19

# ==================== Seeding ====================
# The seed refuses to run against a non-local database unless this is true.
# ALLOW_REMOTE_SEED=true
