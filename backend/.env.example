# Copy to .env and fill in. Placeholders only — never commit real values.
# Every variable here is read by code somewhere; nothing aspirational.

# ==================== Server ====================
NODE_ENV=development
PORT=3000

# ==================== Database ====================
# User/password/db must match backend/docker-compose.yml (POSTGRES_DB: app).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# ==================== Auth / Session ====================
# Required in production — the server refuses to boot without it, and a value
# shorter than 32 characters is ignored. Dev falls back to a random
# per-process secret, so every restart logs everyone out.
# Generate: openssl rand -base64 48
SESSION_SECRET=""
SESSION_TTL_HOURS=12

# true in production (HTTPS only); forced true when NODE_ENV=production.
COOKIE_SECURE=false
# 'lax' works while the frontend shares a site with the API. Split them across
# domains and this must become 'none' with COOKIE_SECURE=true, or the browser
# drops the cookie on every request.
COOKIE_SAMESITE=lax
