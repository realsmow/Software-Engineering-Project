# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/app"

# Port the Nest server listens on
PORT=3000

# Signing key for session JWTs. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to boot without it (see app.module.ts) rather than falling
# back to a default that would be public knowledge.
JWT_SECRET=""

# Set to "true" to log every SQL statement Prisma runs. Off by default
# because it is very noisy; turn it on when a query returns unexpected rows.
LOG_SQL=false
