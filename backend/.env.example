# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Database --------------------------------------------------------------
# Prisma reads this. Point it at the team's shared Postgres, or a local one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ulms?schema=public"

# --- Session ---------------------------------------------------------------
# Signs the ulms_session cookie. The app refuses to boot without it, on
# purpose: an empty secret means every token is forgeable.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Anyone holding this can mint a session for any account, so it must differ
# between development and production and must never be committed.
JWT_SECRET=""

# How long a session lasts before the user has to sign in again.
SESSION_TTL_HOURS=8

# --- Server ----------------------------------------------------------------
PORT=3000

# Set to "production" in a real deployment. It flips the session cookie to
# secure:true, which requires https - leave it unset locally or the browser
# will silently drop the cookie over plain http.
# NODE_ENV=production
