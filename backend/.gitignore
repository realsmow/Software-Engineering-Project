# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Generated clients — regenerated by `prisma generate` / `trpc:generate`.
# Both paths need the /src prefix; without it they resolve to backend/generated/*
# and silently track nothing.
/src/generated/prisma
/src/generated/trpc

# Vendored agent working files
.agents/
.claude/

# บันทึกสรุปงานส่วนตัว ไม่ต้อง push ขึ้น GitHub
/work-summary-*.txt

# Uploaded images (local storage driver — see src/image/image.service.ts)
/media

# Compiled helper scripts (npm run smoke:staff)
/dist-tools
