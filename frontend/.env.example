# API Backend
#
# Both of these are OPTIONAL in development. Left unset, the app uses
# relative URLs ("/api" and "/trpc") which the Vite dev proxy forwards to
# localhost:3000 (see vite.config.ts). Staying on one origin means the
# httpOnly session cookie is first-party and no CORS is involved.
#
# Set them only to reach a backend on another host — that origin must also be
# listed in ALLOWED_ORIGINS in backend/src/main.ts.
#
# REST base (note the /api suffix):
# VITE_API_URL=http://localhost:3000/api
#
# tRPC endpoint (no /api — the backend mounts tRPC at /trpc):
# VITE_TRPC_URL=http://localhost:3000/trpc

# Google OAuth (KU Workspace)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Feature flags
VITE_ENABLE_MOCKS=true
