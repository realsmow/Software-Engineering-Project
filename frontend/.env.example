# ==================== API Backend ====================
# Both must point at the running Nest server. The Vite dev server also
# proxies /api and /trpc to :3000, so these stay on localhost in dev.
VITE_API_URL=http://localhost:3000/api
VITE_TRPC_URL=http://localhost:3000/trpc

# ==================== Feature flags ====================
# false in production. Not read by any code yet; login is mock-gated on
# import.meta.env.DEV instead.
VITE_ENABLE_MOCKS=true
